# Manim render artifacts (when running skills/manim-video scripts locally)
media/
*.log

# Session artifacts if someone invokes the skill inside the project dir
# (normally outputs go to <videos_dir>/edit/ — keep these as a safety net)
edit/
transcripts/
animations/
clips_graded/
clips_preview/
downloads/
verify/
preview.mp4
final.mp4
base.mp4
base_preview.mp4
master.srt
takes_packed.md
edl.json
project.md

# Personal, per-creator templates (never committed — each user builds their own)
templates/

# Overlays pessoais — o pacote e de cada um, e binario grande atrapalha o fork
assets/overlays/*
!assets/overlays/README.md

# SFX pessoais: a biblioteca do usuario vem de pacotes licenciados (Envato
# Elements e afins) que NAO permitem redistribuicao. Os 10 originais do pacote
# seguem versionados; tudo que for adicionado depois fica de fora.
assets/sfx/*.mp3
assets/sfx/*.wav
