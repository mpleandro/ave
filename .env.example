# Copie para `.env` e preencha o que for usar. O `.env` NUNCA é versionado —
# cada pessoa cria o seu. Nenhuma destas é obrigatória para começar: a skill
# pede a chave na primeira vez que precisar dela e grava aqui.

# TRANSCRIÇÃO — a única que o fluxo básico usa.
# Groq Whisper (whisper-large-v3). https://console.groq.com/keys
GROQ_API_KEY=

# Fontes LONGAS (>5 min). O `backend=auto` prefere a Scribe nesses casos porque
# o tier free da Groq engasga com upload longo. Sem ela, cai na Groq.
# https://elevenlabs.io
ELEVENLABS_API_KEY=

# IMAGENS ilustrativas da Fase 2. Sem elas, a busca por imagem fica indisponível
# e a skill diz isso em vez de entregar um vídeo sem os inserts.
# https://www.pexels.com/api/
PEXELS_API_KEY=
# Reserva para marcas e pessoas, quando a Wikimedia (sem chave) não tem.
# Atenção a direitos de uso. https://developers.google.com/custom-search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# TRILHA por IA (Fase 3). Sem ela, a opção "Gerar com IA" aparece travada no
# editor, com o aviso — e os efeitos locais de `assets/sfx/` seguem funcionando.
# https://treblo.ai
TREBLO_API_KEY=
